<!doctype html>
<html lang="es-CO">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#101019">
    <title>{% block title %}GrindFlow · Crea y sigue creando{% endblock %}</title>
    <link rel="stylesheet" href="/assets/grindflow.css?v={{ app_version|url_encode }}">
    {# Inlined for isolated Symfony public root; parity is checked against public/css. #}
    <style data-gf-cookie-inline-css>
/* GrindFlow cookie choice: equal prominence, keyboard and reduced-motion safe. */
.gf-cookie-consent[hidden] { display: none !important; }
.gf-cookie-consent {
  box-sizing: border-box;
  position: fixed;
  z-index: 10000;
  inset-inline: max(1rem, env(safe-area-inset-left)) max(1rem, env(safe-area-inset-right));
  bottom: max(1rem, env(safe-area-inset-bottom));
  max-width: 38rem;
  margin-inline: auto;
  padding: 1.1rem;
  border: 2px solid currentColor;
  border-radius: .75rem;
  background: #101019;
  color: #fff;
  box-shadow: 0 8px 30px rgb(0 0 0 / 35%);
  font: inherit;
}
.gf-cookie-consent *, .gf-cookie-consent *::before, .gf-cookie-consent *::after {
  box-sizing: border-box;
}
.gf-cookie-consent__title { margin: 0 0 .4rem; font-size: 1.1rem; color: inherit; }
.gf-cookie-consent__text { margin: .3rem 0 .8rem; line-height: 1.45; }
.gf-cookie-consent__legal { display: block; margin-block: .5rem; opacity: .85; font-size: .85rem; }
.gf-cookie-consent__actions { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: .75rem; }
.gf-cookie-consent__action {
  min-height: 44px;
  min-width: 112px;
  flex: 1 1 9rem;
  padding: .65rem 1rem;
  border: 2px solid #fff;
  border-radius: .4rem;
  background: #fff;
  color: #101019;
  font: inherit;
  font-weight: 700;
  cursor: pointer;
}
.gf-cookie-consent__action:hover { background: #e6e6e6; }
.gf-cookie-consent__action:focus-visible,
[data-gf-cookie-open]:focus-visible { outline: 3px solid #c3ff4b; outline-offset: 3px; }
.gf-cookie-consent__close {
  min-height: 44px;
  min-width: 44px;
  padding: .25rem;
  border: 1px solid #fff;
  background: transparent;
  color: inherit;
  border-radius: .4rem;
  cursor: pointer;
}
.gf-cookie-consent__close:focus-visible { outline: 3px solid #c3ff4b; outline-offset: 3px; }
[data-gf-cookie-open] { display: inline-flex; align-items: center; min-height: 44px; }
@media (prefers-reduced-motion: reduce) {
  .gf-cookie-consent, .gf-cookie-consent *, .gf-cookie-consent *::before, .gf-cookie-consent *::after {
    animation: none !important;
    transition: none !important;
    scroll-behavior: auto !important;
  }
}
    </style>
    {% block head %}{% endblock %}
</head>
<body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    {% block body %}{% endblock %}
    <footer class="footer">
        <a class="brand brand-small" href="{{ path('grindflow_home') }}">GRIND<span>FLOW</span></a>
        <span>Versión {{ app_version }}</span>
        <span>S1 · Acceso y organizaciones aisladas; sin migración productiva</span>
        <a href="#gf-cookie-consent" data-gf-cookie-open>Cambiar preferencias de cookies</a>
    </footer>
    <section id="gf-cookie-consent" class="gf-cookie-consent" data-gf-cookie-banner
             role="region" aria-labelledby="gf-cookie-consent-title">
        <h2 class="gf-cookie-consent__title" id="gf-cookie-consent-title">Preferencias de cookies</h2>
        <p class="gf-cookie-consent__text">Las cookies opcionales permanecen desactivadas hasta que elijas Aceptar.</p>
        <small class="gf-cookie-consent__legal" data-gf-cookie-legal-pending>Texto legal pendiente de aprobación profesional.</small>
        <div class="gf-cookie-consent__actions">
            <button type="button" class="gf-cookie-consent__action" data-gf-cookie-action="accept">Aceptar</button>
            <button type="button" class="gf-cookie-consent__action" data-gf-cookie-action="reject">Rechazar</button>
        </div>
        <button type="button" class="gf-cookie-consent__close" data-gf-cookie-action="close"
                aria-label="Cerrar aviso y rechazar">Cerrar</button>
    </section>
    {# Inlined for isolated Symfony public root; parity is checked against public/js. #}
    <script data-gf-cookie-inline-js>
/* Privacy-first consent UI for GrindFlow. No optional script is loaded here. */
(function () {
  "use strict";

  if (window.GrindFlowCookieConsent) return;

  const COOKIE_NAME = "gf_cookie_consent_v1";
  const MAX_AGE = 60 * 60 * 24 * 180;
  const choices = ["accepted", "rejected"];

  function storedChoice() {
    const item = document.cookie.split(";").map(function (part) {
      return part.trim();
    }).find(function (part) {
      return part.startsWith(COOKIE_NAME + "=");
    });
    if (!item) return null;
    const value = item.slice(COOKIE_NAME.length + 1);
    return choices.includes(value) ? value : null;
  }

  let choice = storedChoice() || "rejected";
  let isOpen = storedChoice() === null;

  function persist(value) {
    const secure = window.location && window.location.protocol === "https:" ? "; Secure" : "";
    document.cookie = COOKIE_NAME + "=" + value +
      "; Max-Age=" + MAX_AGE + "; Path=/; SameSite=Lax" + secure;
  }

  function render() {
    document.querySelectorAll("[data-gf-cookie-banner]").forEach(function (banner) {
      banner.hidden = !isOpen;
    });
  }

  function notify() {
    window.dispatchEvent(new CustomEvent("grindflow:cookie-consent", {
      detail: { choice: choice, optionalAllowed: choice === "accepted" }
    }));
  }

  function choose(value) {
    if (!choices.includes(value)) return;
    choice = value;
    persist(value);
    isOpen = false;
    render();
    notify();
  }

  function openPreferences() {
    // Opening preferences revokes a prior opt-in; abandoning them means reject.
    if (choice === "accepted") {
      choice = "rejected";
      persist(choice);
      notify();
    }
    isOpen = true;
    render();
    const reject = document.querySelector(
      '[data-gf-cookie-banner] [data-gf-cookie-action="reject"]'
    );
    if (reject) reject.focus();
  }

  function init() {
    document.querySelectorAll("[data-gf-cookie-banner]").forEach(function (banner) {
      banner.addEventListener("click", function (event) {
        const button = event.target && event.target.closest
          ? event.target.closest("[data-gf-cookie-action]") : null;
        if (!button) return;
        const action = button.getAttribute("data-gf-cookie-action");
        choose(action === "accept" ? "accepted" : "rejected");
      });
      banner.addEventListener("keydown", function (event) {
        if (event.key === "Escape") {
          event.preventDefault();
          choose("rejected");
        }
      });
    });
    document.querySelectorAll("[data-gf-cookie-open]").forEach(function (link) {
      link.addEventListener("click", function (event) {
        event.preventDefault();
        openPreferences();
      });
    });
    render();
  }

  window.GrindFlowCookieConsent = Object.freeze({
    getChoice: function () { return choice; },
    optionalAllowed: function () { return choice === "accepted"; },
    openPreferences: openPreferences
  });
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init, { once: true });
  } else {
    init();
  }
})();
    </script>
</body>
</html>
