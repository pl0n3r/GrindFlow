{% extends 'base.html.twig' %}
{% block title %}Ingresar · GrindFlow{% endblock %}
{% block body %}
{% include "identity/_header.html.twig" with { current_label: "Ingresar" } only %}
<main id="contenido" class="identity-shell">
    <section class="identity-card" aria-labelledby="login-title">
        <span class="eyebrow">ACCESO PRIVADO · ENTORNO S1</span>
        <h1 id="login-title">Ingresa a tu espacio</h1>
        <p>Usa una cuenta del entorno Symfony aislado. Las cuentas del sitio actual aún no se han migrado.</p>
        {% if login_error %}
            <p id="identity-login-error" role="alert" class="identity-error">No se pudo iniciar sesión. Revisa tus datos o el estado de tu cuenta.</p>
        {% endif %}
        <form method="post" action="{{ path('grindflow_login') }}" class="identity-form">
            <label for="identity-email">Correo electrónico</label>
            <input id="identity-email" name="email" type="email" autocomplete="username"
                value="{{ last_email }}" required maxlength="255"
                {% if login_error %}aria-invalid="true" aria-describedby="identity-login-error"{% endif %}>
            <label for="identity-password">Contraseña</label>
            <input id="identity-password" name="password" type="password" autocomplete="current-password" required
                {% if login_error %}aria-invalid="true" aria-describedby="identity-login-error"{% endif %}>
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
            <button class="button primary" type="submit">Entrar</button>
        </form>
        <a href="{{ path('grindflow_home') }}">Volver al inicio</a>
    </section>
</main>
{% endblock %}
