{% extends 'base.html.twig' %}
{% block title %}{{ organization.name }} · GrindFlow{% endblock %}
{% block head %}
<meta name="robots" content="noindex,nofollow">
{% for stylesheet in build.css %}<link rel="stylesheet" href="{{ stylesheet }}">{% endfor %}
{% endblock %}
{% block body %}
<div class="admin-page">
    <div class="admin-actions">
        <a href="{{ path('grindflow_organizations') }}">Cambiar organización</a>
        <form method="post" action="{{ path('grindflow_logout') }}">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
            <button type="submit">Cerrar sesión</button>
        </form>
    </div>
    <div id="grindflow-admin" data-organization="{{ organization.id }}">
        <section class="admin-state" aria-live="polite"><span class="admin-pulse"></span>Cargando espacio seguro…</section>
    </div>
    <noscript><p class="admin-state">Activa JavaScript para usar el panel administrativo.</p></noscript>
</div>
<script type="module" src="{{ build.js }}"></script>
{% endblock %}
