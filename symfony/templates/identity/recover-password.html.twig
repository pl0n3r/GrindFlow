{% extends 'base.html.twig' %}
{% block title %}Nueva contraseña · GrindFlow{% endblock %}
{% block head %}<meta name="referrer" content="no-referrer">{% endblock %}
{% block body %}
{% include "identity/_header.html.twig" with { current_label: "Nueva contraseña" } only %}
<main id="contenido" tabindex="-1" class="identity-shell">
  <section class="identity-card" aria-labelledby="reset-title">
    <span class="eyebrow">SEGURIDAD DE CUENTA</span>
    <h1 id="reset-title">Crea una nueva contraseña</h1>
    {% if changed %}
      <p role="status">Tu contraseña cambió. Todas las sesiones anteriores deben autenticarse de nuevo.</p>
      <a class="button primary" href="{{ path('grindflow_login') }}">Ingresar</a>
    {% else %}
      {% if recovery_error %}<p role="alert" class="identity-error">{{ recovery_error }}</p>{% endif %}
      <form method="post" action="{{ path('grindflow_password_recover') }}" class="identity-form" id="password-recovery-form">
        <input id="password-recovery-token" name="token" type="hidden" value="">
        <label for="recovery-password">Nueva contraseña</label>
        <input id="recovery-password" name="new_password" type="password" autocomplete="new-password" minlength="12" maxlength="128" required>
        <label for="recovery-confirmation">Confirmar contraseña</label>
        <input id="recovery-confirmation" name="confirm_password" type="password" autocomplete="new-password" minlength="12" maxlength="128" required>
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('grindflow_password_recovery_reset') }}">
        <button class="button primary" type="submit">Cambiar contraseña</button>
      </form>
      <script>
      (() => {
        const token = new URLSearchParams(window.location.hash.slice(1)).get('token') || '';
        document.getElementById('password-recovery-token').value = token;
        if (window.location.hash) history.replaceState(null, '', window.location.pathname);
      })();
      </script>
    {% endif %}
  </section>
</main>
{% endblock %}
