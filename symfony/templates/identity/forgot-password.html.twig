{% extends 'base.html.twig' %}
{% block title %}Recuperar acceso · GrindFlow{% endblock %}
{% block head %}<meta name="referrer" content="no-referrer">{% endblock %}
{% block body %}
{% include "identity/_header.html.twig" with { current_label: "Recuperar acceso" } only %}
<main id="contenido" tabindex="-1" class="identity-shell">
  <section class="identity-card" aria-labelledby="recovery-title">
    <span class="eyebrow">SEGURIDAD DE CUENTA</span>
    <h1 id="recovery-title">Recupera tu acceso</h1>
    {% if sent %}
      <p role="status">{{ message }}</p>
      <a class="button primary" href="{{ path('grindflow_login') }}">Volver a ingresar</a>
    {% else %}
      <p>Escribe el correo de tu cuenta. La respuesta es la misma exista o no una cuenta activa.</p>
      <form method="post" action="{{ path('grindflow_password_forgot') }}" class="identity-form">
        <label for="recovery-email">Correo electrónico</label>
        <input id="recovery-email" name="email" type="email" autocomplete="email" maxlength="255" required>
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('grindflow_password_recovery_request') }}">
        <button class="button primary" type="submit">Enviar instrucciones</button>
      </form>
    {% endif %}
  </section>
</main>
{% endblock %}
